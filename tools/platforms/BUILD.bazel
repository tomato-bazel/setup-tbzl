"""Target platforms for the release cross-compiles.

Pass `--platforms=//tools/platforms:linux_amd64` to build the x86-64 Linux artifact — the
arch the CI runners execute — from a mac, via zig cc.

⚠ `linux_arm64` exists although nothing consumes it yet. `tomato-bazel/cred-helper` publishes
NO linux-arm64 asset, so an arm64 worker shape today has a credential helper it cannot run;
having the target here means that gap is a release-workflow line rather than a toolchain
project.
"""

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)
