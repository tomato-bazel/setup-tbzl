# setup-tbzl — the binary behind the composite Action.
#
# ⚠ ALL DEPENDENCIES ARE PUBLIC (BCR + crates.io), SO THIS BUILD NEEDS NO CREDENTIALS. That is
# load-bearing rather than incidental. This repository is PUBLIC because `savvifi/aion` is a
# different org from `tomato-bazel` and a private repo's Action cannot be consumed cross-org —
# the same wall that forced `tbzl-profile` public. A build that needed a private registry
# would put a credential back in front of every consumer, which is the problem this Action
# exists to remove.
#
# ⛔ AND THE CONSEQUENCE OF BEING PUBLIC IS NOT ONLY CONVENIENCE. A live BuildBuddy API key
# reached `tbzl-profile` within hours of it being made public, pasted from a BEP fixture.
# `tests/fixtures_are_scrubbed.rs` and the gitleaks gate in `.github/workflows/ci.yml` are
# both required here for that reason.

module(
    name = "setup_tbzl",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_rust", version = "0.70.0")

# ⭐ Zig cc supplies the Linux sysroots, so the x86-64 artifact CI runners consume is built
# from the same job — and therefore the same commit — as the darwin one. Two jobs could
# disagree about which commit they built.
#
# ⚠ glibc 2.28 is pinned to match the runner image. Build against a newer glibc and the binary
# fails at exec with a version-mismatch message that names the loader rather than the
# toolchain.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
)
use_repo(zig_toolchains, "zig_sdk")

# ⚠ Linux cross-targets ONLY. A host darwin build uses the system clang; zig's ld64 does not
# implement the Apple-specific linker flags Bazel emits, so registering a darwin zig toolchain
# breaks the host build rather than helping it.
register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        # ⚠ arm64 is registered even though no consumer runs on it yet, because
        # `cred-helper` publishes NO linux-arm64 artifact and discovering that at cutover
        # time is worse than carrying an unused toolchain.
        "aarch64-unknown-linux-gnu",
    ],
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension(
    "@rules_rust//crate_universe:extension.bzl",
    "crate",
    isolate = True,
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")
